# Local development only. Never put real credentials in this file.
APP_ENV=development
DRY_RUN=true
EXTERNAL_SIDE_EFFECTS_ENABLED=false

# Container-internal endpoints used by M0-05. Random local credentials are generated
# into ignored .runtime/compose.env by `npm run stack:up`; never copy real credentials here.
DATABASE_URL=postgresql://agent_ip:<generated-local-password>@postgres:5432/agent_ip
TEMPORAL_ADDRESS=temporal:7233
OBJECT_STORAGE_ENDPOINT=http://object-storage:3900
OBJECT_STORAGE_ACCESS_KEY=<generated-local-access-key>
OBJECT_STORAGE_SECRET_KEY=<generated-local-secret-key>
